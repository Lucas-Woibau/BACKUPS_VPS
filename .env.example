# ============================================================================
# VPS Backup Manager — variáveis de ambiente
# Copie para .env (cp .env.example .env && chmod 600 .env). NUNCA versione o .env.
# O scripts/install.sh cria o .env automaticamente com uma chave aleatória.
# ============================================================================

# Chave mestra (>= 32 caracteres). Criptografa as senhas dos bancos guardadas no SQLite (AES-256-GCM).
# Gere com: openssl rand -base64 48
# Se perder/trocar esta chave, será preciso redigitar as senhas das conexões (os backups não dependem dela).
APP_SECRET_KEY=

# Alternativa (Docker secrets): caminho de um arquivo com a chave.
# APP_SECRET_KEY_FILE=/run/secrets/app_secret_key

# Rede: endereço/porta publicados no host. Mantenha 127.0.0.1 (acesso via túnel SSH, VPN ou proxy HTTPS).
BIND_ADDRESS=127.0.0.1
APP_PORT=8080

# Nome exibido como hostname no painel (opcional)
VPS_HOSTNAME=

# Timezone inicial (pode ser alterada no painel)
TZ_DEFAULT=America/Sao_Paulo

# Sessão do painel
# true quando o acesso for via HTTPS (reverse proxy) — marca o cookie como Secure.
SESSION_COOKIE_SECURE=false
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=60

# Reverse proxy: confiar em X-Forwarded-For/Proto apenas destas redes.
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_NETWORKS=127.0.0.1/32,172.16.0.0/12

# Descoberta opcional de containers (requer: docker compose --profile discovery up -d)
DOCKER_DISCOVERY_URL=
# DOCKER_DISCOVERY_URL=http://docker-proxy:2375

# Nome usado para alcançar o host a partir do container (extra_hosts)
HOST_GATEWAY_NAME=host.docker.internal

LOG_LEVEL=Information

# Build da imagem
PG_CLIENT_VERSION=18
MYSQL_CLIENT_FLAVOR=mariadb

# ---------------------------------------------------------------------------
# Produção com imagem do GHCR (docker-compose.prod.yml) — preenchido por scripts/setup-vps.sh
# ---------------------------------------------------------------------------
# IMAGE_TAG=latest
# MYSEEDS_NETWORK=
# MYSEEDS_BACKUP_DIR=
# BIBLIOTRACK_NETWORK=
# BIBLIOTRACK_BACKUP_DIR=